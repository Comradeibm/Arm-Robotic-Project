<?xml version="1.0"?>
<!--
  six_dof_arm.urdf
  =================
  URDF description of the same 6-DOF arm modeled in src/kinematics.py
  (link lengths/offsets match the DH table there). Used by RViz for
  visualization and by Gazebo for physics simulation.

  Load in RViz:
    roslaunch six_dof_arm_description display.launch  (see ../launch/arm_sim.launch)

  Load in Gazebo:
    roslaunch six_dof_arm_description gazebo.launch
-->
<robot name="six_dof_arm">

  <material name="grey">  <color rgba="0.6 0.6 0.6 1.0"/> </material>
  <material name="orange"><color rgba="0.9 0.5 0.1 1.0"/> </material>

  <link name="base_link">
    <visual>
      <geometry><cylinder radius="0.08" length="0.05"/></geometry>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.08" length="0.05"/></geometry>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <!-- J1: base yaw, d=0.15 -->
  <link name="link1">
    <visual>
      <geometry><cylinder radius="0.05" length="0.15"/></geometry>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <material name="orange"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.05" length="0.15"/></geometry>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
    </collision>
    <inertial><mass value="1.0"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/></inertial>
  </link>
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.967" upper="2.967" effort="50" velocity="2.0"/>
  </joint>

  <!-- J2: shoulder, a=0.30 -->
  <link name="link2">
    <visual>
      <geometry><cylinder radius="0.04" length="0.30"/></geometry>
      <origin xyz="0.15 0 0" rpy="0 1.5708 0"/>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.30"/></geometry>
      <origin xyz="0.15 0 0" rpy="0 1.5708 0"/>
    </collision>
    <inertial><mass value="1.5"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.967" upper="2.967" effort="50" velocity="2.0"/>
  </joint>

  <!-- J3: elbow, a=0.25 -->
  <link name="link3">
    <visual>
      <geometry><cylinder radius="0.035" length="0.25"/></geometry>
      <origin xyz="0.125 0 0" rpy="0 1.5708 0"/>
      <material name="orange"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.035" length="0.25"/></geometry>
      <origin xyz="0.125 0 0" rpy="0 1.5708 0"/>
    </collision>
    <inertial><mass value="1.0"/><inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.008"/></inertial>
  </link>
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.30 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.967" upper="2.967" effort="30" velocity="2.5"/>
  </joint>

  <!-- J4: wrist roll, d=0.20 -->
  <link name="link4">
    <visual>
      <geometry><cylinder radius="0.03" length="0.20"/></geometry>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.03" length="0.20"/></geometry>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
    </collision>
    <inertial><mass value="0.6"/><inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.004"/></inertial>
  </link>
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0.25 0 0" rpy="0 1.5708 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.967" upper="2.967" effort="15" velocity="3.0"/>
  </joint>

  <!-- J5: wrist pitch -->
  <link name="link5">
    <visual>
      <geometry><sphere radius="0.035"/></geometry>
      <material name="orange"/>
    </visual>
    <collision><geometry><sphere radius="0.035"/></geometry></collision>
    <inertial><mass value="0.3"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 0 0.20" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.967" upper="2.967" effort="10" velocity="3.0"/>
  </joint>

  <!-- J6: wrist yaw / flange, d=0.10 -->
  <link name="link6">
    <visual>
      <geometry><cylinder radius="0.025" length="0.10"/></geometry>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.025" length="0.10"/></geometry>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
    </collision>
    <inertial><mass value="0.2"/><inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/></inertial>
  </link>
  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.967" upper="2.967" effort="10" velocity="3.0"/>
  </joint>

  <link name="end_effector"/>
  <joint name="ee_fixed" type="fixed">
    <parent link="link6"/>
    <child link="end_effector"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo: ros_control plugin for joint_trajectory_controller -->
  <gazebo>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
      <robotNamespace>/six_dof_arm</robotNamespace>
    </plugin>
  </gazebo>

  <transmission name="tran1"><type>transmission_interface/SimpleTransmission</type>
    <joint name="joint1"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface></joint>
    <actuator name="motor1"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface><mechanicalReduction>1</mechanicalReduction></actuator>
  </transmission>
  <transmission name="tran2"><type>transmission_interface/SimpleTransmission</type>
    <joint name="joint2"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface></joint>
    <actuator name="motor2"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface><mechanicalReduction>1</mechanicalReduction></actuator>
  </transmission>
  <transmission name="tran3"><type>transmission_interface/SimpleTransmission</type>
    <joint name="joint3"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface></joint>
    <actuator name="motor3"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface><mechanicalReduction>1</mechanicalReduction></actuator>
  </transmission>
  <transmission name="tran4"><type>transmission_interface/SimpleTransmission</type>
    <joint name="joint4"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface></joint>
    <actuator name="motor4"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface><mechanicalReduction>1</mechanicalReduction></actuator>
  </transmission>
  <transmission name="tran5"><type>transmission_interface/SimpleTransmission</type>
    <joint name="joint5"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface></joint>
    <actuator name="motor5"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface><mechanicalReduction>1</mechanicalReduction></actuator>
  </transmission>
  <transmission name="tran6"><type>transmission_interface/SimpleTransmission</type>
    <joint name="joint6"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface></joint>
    <actuator name="motor6"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface><mechanicalReduction>1</mechanicalReduction></actuator>
  </transmission>

</robot>
